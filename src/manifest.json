{
  "manifest_version": 3,
  "name": "netflix-subtitle-study",
  "description": "A Chrome extension for studying languages with Netflix subtitles",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-34.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "contentLoader.bundle.js"
      ],
      "css": [
        "content.styles.css"
      ]
    }
  ],
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    {
      "resources": [
        "content.styles.css",
        "icon-128.png",
        "icon-34.png",
        "contentScript.bundle.js"
      ],
      "matches": [
        "https://www.netflix.com/*"
      ]
    }
  ]
}
